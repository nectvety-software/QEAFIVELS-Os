From 88a317d56295586d849bf2816f5e7b4b7c4b7257 Mon Sep 17 00:00:00 2001
From: Deven Solanki <quic_dsolanki@quicinc.com>
Date: Tue, 3 Jan 2023 11:44:54 +0530
Subject: [PATCH] disp: msm: clear platform device drvdata on msm_drm bind fail

For msm_drm_bind() fail case, clear driver data pointer from pdev.

Change-Id: I4add058b77a703389c1f1928b90aa09640c2ce6a
Signed-off-by: Deven Solanki <quic_dsolanki@quicinc.com>
Backport-source: AxionAOSP-devices/android_kernel_xiaomi_violet@88a317d56295586d849bf2816f5e7b4b7c4b7257
Target-base: MiCode/Xiaomi_Kernel_OpenSource@1488fa3d05e2f9be5fc62e0bb16ad85d96db2076
---
 drivers/gpu/drm/msm/msm_drv.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/gpu/drm/msm/msm_drv.c b/drivers/gpu/drm/msm/msm_drv.c
--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -789,6 +789,7 @@ static int msm_drm_init(struct device *dev, struct drm_driver *drv)
 	kfree(priv);
 priv_alloc_fail:
 	drm_dev_unref(ddev);
+	platform_set_drvdata(pdev, NULL);
 	return ret;
 }
 
