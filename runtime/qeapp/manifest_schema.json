{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VQEAF QEAPP manifest v1",
  "type": "object",
  "required": ["format","format_version","id","name","version","min_os","entry","architecture","permissions","dependencies"],
  "properties": {
    "format": {"const":"qeapp"},
    "format_version": {"const":1},
    "id": {"type":"string","pattern":"^[a-z0-9]+([.-][a-z0-9]+)+$"},
    "name": {"type":"string","minLength":1},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "min_os": {"type":"string"},
    "entry": {"type":"string","pattern":"^[A-Za-z0-9_./-]+\\.qe$"},
    "architecture": {"type":"array","items":{"enum":["arm64","x86_64"]},"minItems":1},
    "permissions": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array"}
  },
  "additionalProperties": true
}
